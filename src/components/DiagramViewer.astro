<!-- One shared viewer also handles diagrams loaded into the project window. -->
<dialog class="diagram-viewer" aria-labelledby="diagram-viewer-title" aria-describedby="diagram-viewer-help">
  <header class="diagram-viewer-bar">
    <h2 id="diagram-viewer-title"></h2>
    <button type="button" class="game-control" data-diagram-zoom="-1" aria-label="Zoom out">−</button>
    <button type="button" class="game-control" data-diagram-zoom="1" aria-label="Zoom in">+</button>
    <button type="button" class="game-control" data-diagram-close aria-label="Close diagram">×</button>
  </header>
  <p id="diagram-viewer-help"></p>
  <div class="diagram-viewer-stage" tabindex="0" role="region" aria-labelledby="diagram-viewer-title"></div>
</dialog>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('.diagram-viewer')!;
  const stage = viewer.querySelector<HTMLElement>('.diagram-viewer-stage')!;
  const heading = viewer.querySelector<HTMLElement>('h2')!;
  const help = viewer.querySelector<HTMLElement>('#diagram-viewer-help')!;
  const close = viewer.querySelector<HTMLButtonElement>('[data-diagram-close]')!;
  const zoomButtons = [...viewer.querySelectorAll<HTMLButtonElement>('[data-diagram-zoom]')];
  let current: { svg: SVGSVGElement; marker: Comment; style: string | null; opener: HTMLButtonElement; width: number } | null = null;
  let zoom = 1;
  const renderZoom = () => {
    if (!current) return;
    current.svg.style.width = current.width * zoom + 'px';
    current.svg.style.maxWidth = 'none';
    current.svg.style.height = 'auto';
    help.textContent = document.documentElement.lang === 'ko'
      ? `배율 ${Math.round(zoom * 100)}% · 스크롤 또는 쓸어서 연결 관계를 살펴보세요.`
      : `${Math.round(zoom * 100)}% · Scroll or swipe to follow the connections.`;
    zoomButtons[0].disabled = zoom <= 1;
    zoomButtons[1].disabled = zoom >= 2;
  };
  document.addEventListener('click', event => {
    const opener = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('.diagram-expand') : null;
    const svg = opener?.closest('figure')?.querySelector('svg');
    if (!opener || !svg || viewer.open) return;
    const marker = document.createComment('diagram position');
    const width = svg.viewBox.baseVal.width;
    if (!width) return;
    const ko = document.documentElement.lang === 'ko';
    heading.textContent = svg.querySelector('title')?.textContent || (ko ? '다이어그램' : 'Diagram');
    close.setAttribute('aria-label', ko ? '다이어그램 닫기' : 'Close diagram');
    zoomButtons[0].setAttribute('aria-label', ko ? '축소' : 'Zoom out');
    zoomButtons[1].setAttribute('aria-label', ko ? '확대' : 'Zoom in');
    current = { svg, marker, opener, width, style: svg.getAttribute('style') };
    // Move instead of clone: keep SVG title/marker IDs unique and restore on close.
    svg.replaceWith(marker); stage.replaceChildren(svg); zoom = 1; renderZoom();
    document.documentElement.classList.add('diagram-open');
    viewer.showModal(); stage.scrollTo(0, 0); close.focus({ preventScroll: true });
  });
  zoomButtons.forEach(button => button.addEventListener('click', () => {
    zoom = Math.max(1, Math.min(2, zoom + Number(button.dataset.diagramZoom) * .25));
    renderZoom();
  }));
  close.addEventListener('click', () => viewer.close());
  viewer.addEventListener('click', event => { if (event.target === viewer) viewer.close(); });
  viewer.addEventListener('close', () => {
    if (current) {
      const { svg, marker, style, opener } = current;
      if (style === null) svg.removeAttribute('style'); else svg.setAttribute('style', style);
      marker.replaceWith(svg);
      if (opener.isConnected) opener.focus({ preventScroll: true });
      current = null;
    }
    stage.replaceChildren(); document.documentElement.classList.remove('diagram-open');
  });
  const dismiss = () => { if (viewer.open) viewer.close(); };
  addEventListener('popstate', dismiss); addEventListener('hashchange', dismiss);
  document.addEventListener('portfolio:locale-change', dismiss);
</script>
<style is:global>
  .diagram-expand { display: none; }
  .diagram-open { overflow: hidden; }
  .diagram-viewer { position: fixed; inset: 16px; width: calc(100% - 32px); max-width: 1180px; height: calc(100dvh - 32px); max-height: none; margin: auto; padding: 12px; border: 3px solid var(--border); border-radius: var(--radius-md); background: var(--panel); color: var(--text); box-shadow: var(--shadow-dialog); overflow: hidden; }
  .diagram-viewer[open] { display: flex; flex-direction: column; gap: 12px; }
  .diagram-viewer::backdrop { background: var(--dialog-backdrop); backdrop-filter: blur(6px); }
  .diagram-viewer-bar { display: flex; align-items: center; gap: 6px; flex: none; }
  .diagram-viewer-bar h2 { flex: 1; min-width: 0; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .diagram-viewer-bar .game-control { flex: none; width: 44px; height: 44px; font-size: 24px; }
  .diagram-viewer-bar button:disabled { opacity: .4; cursor: default; }
  #diagram-viewer-help { margin: 0; font-size: 12px; line-height: 1.6; color: var(--text-secondary); }
  .diagram-viewer-stage { flex: 1; min-width: 0; min-height: 0; overflow: auto; overscroll-behavior: contain; background: var(--surface); padding: 12px; }
  .diagram-viewer-stage > svg { display: block; margin: 0; }
  .diagram-viewer-stage:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  @media (max-width: 820px) {
    .project-diagram { min-width: 0; max-width: 100%; padding: 16px 8px 8px; overflow: hidden; }
    .project-diagram > svg { width: 100% !important; max-width: 100% !important; }
    .diagram-expand { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; margin-top: 12px; padding: 8px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-dark); color: var(--accent); font-family: inherit; font-size: 13px; font-weight: 600; line-height: 1.5; cursor: pointer; }
    .diagram-expand:is(:hover, :focus-visible) { border-color: var(--border-highlight); background: var(--surface-strong); }
    html[lang="ko"] .diagram-expand [lang="en"], html[lang="en"] .diagram-expand [lang="ko"] { display: none; }
  }
</style>
