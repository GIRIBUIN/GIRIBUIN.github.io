---
import PortfolioExplorer from './explorer/PortfolioExplorer';
import ProjectActionIcon from './ProjectActionIcon.astro';
import { getProjects } from '../lib/projects';
import { projectToExplorer } from '../lib/explorer-data';
import type { Locale } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const projects = await Promise.all((await getProjects()).map(projectToExplorer));
---
<PortfolioExplorer projects={projects} locale={locale} embedded client:load>
  <ProjectActionIcon slot="detailsIcon" name="deepDive" />
  <ProjectActionIcon slot="demoIcon" name="liveDemo" />
  <ProjectActionIcon slot="sourceIcon" name="source" />
  <ProjectActionIcon slot="downloadIcon" name="release" />
  <ProjectActionIcon slot="videoIcon" name="video" />
</PortfolioExplorer>
