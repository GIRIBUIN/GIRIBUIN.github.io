---
import { render } from 'astro:content';
import type { Project } from '../lib/projects';
import ProjectDemo from './ProjectDemo.astro';
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
const { title, slug, type, oneLine, summary, tech, problem, decision, result, links } = project.data;
const { Content } = await render(project);
const facts = [{ label: 'Problem', text: problem }, { label: 'Decision', text: decision }, { label: 'Result', text: result }].filter(fact => fact.text);
---
<article class="showcase" data-project={slug} aria-labelledby={'project-' + slug}>
  <div class="showcase-title"><span class="project-index mono">{String(index + 1).padStart(2, '0')}</span><h3 id={'project-' + slug}>{title}</h3><span class="project-type mono">{type}</span></div>
  <div class="showcase-body">
    <div class="project-copy"><p class="one-line">{oneLine || summary}</p>{oneLine && <p class="summary">{summary}</p>}
      {facts.length > 0 && <dl class="project-facts">{facts.map(fact => <div><dt class="mono">{fact.label}</dt><dd>{fact.text}</dd></div>)}</dl>}
      {tech.length > 0 && <p class="tech mono">{tech.join(' / ')}</p>}
      <div class="project-actions"><a class="text-link" href={'/work/' + slug + '/'}>Deep dive <span aria-hidden="true">↗</span></a>{links.source && <a href={links.source} target="_blank" rel="noreferrer">Source ↗</a>}</div>
    </div>
    <ProjectDemo project={project} />
  </div>
  <details class="project-expand"><summary>프로젝트 기록 펼치기 <span aria-hidden="true">+</span></summary><div class="prose"><Content /></div></details>
</article>
