---
import { getProjectCardMeta, getProjectDeepDiveLink, type Project } from '../lib/projects';
import { getUi, type Locale } from '../i18n/ui';
import ProjectTitle from './ProjectTitle.astro';
import ProjectDemo from './ProjectDemo.astro';
import ProjectActions from './ProjectActions.astro';
interface Props { project: Project; locale?: Locale; }
const { project, locale = 'en' } = Astro.props;
const { title, logo, slug, oneLine, summary } = project.data;
const meta = getProjectCardMeta(project);
const deepDive = getProjectDeepDiveLink(project, locale);
const deepDiveLabel = getUi(locale).project.deepDive;
---
<article class="showcase" data-project={slug} aria-labelledby={'project-' + slug}>
  <ProjectDemo project={project} locale={locale} preview />
  <a class="project-card-link" href={deepDive.href} data-locale-path={deepDive.localPath || undefined} target={deepDive.external ? '_blank' : undefined} rel={deepDive.external ? 'noreferrer' : undefined} aria-label={title + ': ' + deepDiveLabel} title={deepDiveLabel} data-i18n-title="project.deepDive" data-project-title={title} data-action-copy="project.deepDive"><span class="visually-hidden" data-i18n="project.deepDive">{deepDiveLabel}</span></a>
  <div class="showcase-copy">
    <p class="project-type" data-i18n={'projects.' + slug + '.meta'} data-stable-copy>{meta}</p>
    <ProjectTitle title={title} logo={logo} id={'project-' + slug} />
    <p class="one-line" data-i18n={'projects.' + slug + '.oneLine'} data-stable-copy>{oneLine || summary}</p>
    <ProjectActions project={project} locale={locale} />
  </div>
</article>
