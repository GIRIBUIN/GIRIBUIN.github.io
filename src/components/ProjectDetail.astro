---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectDemo from './ProjectDemo.astro';
import DiagramViewer from './DiagramViewer.astro';
import InterfaceIcon from './InterfaceIcon.astro';
import { localizeProject, projectLinks, projectPath, type Project } from '../lib/projects';
import { getUi, localePath, type Locale } from '../lib/i18n';
interface Props { project: Project; locale?: Locale; }
const { project: entry, locale = 'en' } = Astro.props;
const project = localizeProject(entry, locale);
const { title, summary, oneLine, slug, technologies, ownership, category, origin, status, validation, problem, decision, result, role, tags } = project.data;
const notes = await getCollection('projectNotes');
const noteId = project.data.notes?.[locale] || locale + '/' + slug;
const note = notes.find(note => note.id === noteId);
const { Content } = await render(note || entry);
const ui = getUi(locale);
const links = projectLinks(project, locale);
const contribution = role?.[locale] || (ownership ? summary : null);
---
<Layout title={title} description={oneLine || summary} locale={locale} canonicalPath={projectPath(slug, locale)}>
  <article class="detail-page" data-project={slug}>
    <header class="detail-header">
      <a class="back-link" href={localePath('/projects/', locale)}>← {ui.back}</a>
      {(category || status) && <p class="eyebrow">{category}{category && status && <span aria-hidden="true">/</span>}{status && ui.projectStatus[status]}</p>}
      <h1>{title}</h1><p class="detail-lead">{oneLine || summary}</p>
      {technologies.length > 0 && <p class="tech-line">{technologies.join(' · ')}</p>}
      <p class="project-meta">{ownership?.type === 'team' ? ui.team + (ownership.teamSize ? ' · ' + ownership.teamSize + ' ' + ui.people : '') : ownership?.type === 'personal' ? ui.personal : ''}{origin && <> / {ui.projectOrigin[origin]}</>}{validation && <> / {ui.validationLabel}: {ui.validation[validation]}</>}{tags.length > 0 && <> / {tags.join(' · ')}</>}</p>
      {links.length > 0 && <nav class="icon-links project-links" aria-label={ui.links}>{links.map(link => <a class="icon-link" href={link.url} aria-label={link.label} title={link.label}><InterfaceIcon name={link.icon} /></a>)}</nav>}
    </header>
    {(problem || contribution || decision) && <section class="project-brief" aria-label={ui.overview}><dl>
      {problem && <div><dt>{ui.problem}</dt><dd>{problem}</dd></div>}
      {contribution && <div><dt>{ui.role}</dt><dd>{contribution}</dd></div>}
      {decision && <div><dt>{ui.decision}</dt><dd>{decision}</dd></div>}
    </dl></section>}
    <ProjectDemo project={project} locale={locale} />
    {!note && locale === 'en' && <p class="translation-note">{ui.translationNote}</p>}
    <div class="prose" lang={locale === 'en' && !note ? 'ko' : locale} data-project-body><Content /></div>
    {result && <section class="result-section" aria-labelledby="result-heading"><h2 id="result-heading">{ui.result}</h2><p>{result}</p></section>}
    <a class="back-link bottom-back" href={localePath('/projects/', locale)}>← {ui.back}</a>
  </article>
  <DiagramViewer />
</Layout>
