---
import type { Project } from '../lib/projects';
interface Props { project: Project; compact?: boolean; }
const { project, compact = false } = Astro.props;
const { title, demo, visual, links } = project.data;
const fullDemo = links.demo || (demo.type === 'iframe' ? demo.url : null);
const mediaUrl = demo.url;
const mediaIsImage = demo.type === 'image' || (demo.type === 'terminal' && demo.format === 'image');
const canRender = Boolean(mediaUrl && ['iframe', 'video', 'terminal', 'image'].includes(demo.type));
const labels = { iframe: 'WEB PREVIEW', video: 'VIDEO WALKTHROUGH', terminal: 'TERMINAL SESSION', apk: 'ANDROID DEMO', image: 'IMAGE PREVIEW', none: 'PROJECT PREVIEW' };
---
<div class:list={['demo', 'demo-' + demo.type, { compact }]} data-demo-type={demo.type} data-demo-state={canRender ? 'ready' : 'fallback'}>
  <div class="demo-toolbar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{labels[demo.type]}</span><span class="demo-status">{canRender ? 'PREVIEW' : 'PLACEHOLDER'}</span></div>
  <div class="demo-stage">
    {canRender && demo.type === 'iframe' ? (
      <iframe src={mediaUrl!} title={title + ' 웹 Demo'} loading="lazy" sandbox="allow-scripts allow-same-origin allow-forms" referrerpolicy="no-referrer" allow="fullscreen"></iframe>
    ) : canRender && mediaIsImage ? (
      <img src={mediaUrl!} alt={demo.alt!} loading="lazy" width="1200" height="750" />
    ) : canRender ? (
      <video src={mediaUrl!} poster={demo.poster || undefined} controls preload="none" playsinline aria-label={title + ' Demo 영상'}><a href={mediaUrl!}>Demo 영상 열기</a></video>
    ) : visual ? (
      <figure class="reference-image"><img src={visual.url} alt={visual.alt} loading="lazy" width="1200" height="750" /><figcaption>{visual.caption || '참고 이미지'} · Demo 연결 준비 중</figcaption></figure>
    ) : (
      <div class="demo-placeholder">
        {demo.type === 'apk' ? <div class="phone-wireframe" aria-hidden="true"><div class="phone-notch"></div><div class="wire-line wide"></div><div class="wire-line"></div><div class="wire-row"></div><div class="wire-row"></div><div class="wire-row short"></div><div class="wire-nav"></div></div>
        : demo.type === 'terminal' ? <div class="terminal-wireframe" aria-hidden="true"><span>~/demo $</span><div class="wire-line wide"></div><div class="wire-line"></div><div class="wire-line wide"></div><span class="terminal-cursor">▍</span></div>
        : <div class="web-wireframe" aria-hidden="true"><div class="wire-sidebar"></div><div class="wire-content"><div class="wire-line"></div><div class="wire-line wide"></div><div class="wire-grid"><i></i><i></i></div><div class="wire-chart"></div></div></div>}
        <div class="placeholder-copy"><span class="mono">PREVIEW / {demo.type.toUpperCase()}</span><p>{demo.type === 'none' ? '프로젝트 기록을 준비하고 있습니다.' : demo.type === 'apk' && demo.url ? 'Demo Mode APK를 내려받아 확인하세요.' : 'Demo를 연결할 자리입니다.'}</p><span>화면 구성용 placeholder</span></div>
      </div>
    )}
  </div>
  <div class="demo-caption"><span>{demo.caption || (canRender ? 'Demo 미리보기' : '실제 Demo는 아직 연결하지 않았습니다.')}</span><div>
    {fullDemo && <a href={fullDemo} target="_blank" rel="noreferrer">Open Full Demo ↗</a>}
    {demo.type === 'apk' && demo.url && <a href={demo.url} target="_blank" rel="noreferrer">Download APK ↗</a>}
    {links.video && <a href={links.video} target="_blank" rel="noreferrer">Watch video ↗</a>}
    {links.release && <a href={links.release} target="_blank" rel="noreferrer">Release ↗</a>}
    {canRender && !fullDemo && <a href={mediaUrl!} target="_blank" rel="noreferrer">원본 열기 ↗</a>}
  </div></div>
</div>
<script>
  // 로드할 수 없는 미디어도 깨진 요소 대신 안내와 원본 링크를 남깁니다.
  document.querySelectorAll<HTMLMediaElement | HTMLImageElement>('.demo-stage video, .demo-stage img').forEach(media => {
    const fallback = () => {
      const message = document.createElement('p');
      message.className = 'media-error';
      message.textContent = '미리보기를 불러오지 못했습니다. 원본 링크 또는 상세 기록을 확인해 주세요.';
      media.replaceWith(message);
    };
    media.addEventListener('error', fallback, { once: true });
    if (media instanceof HTMLImageElement && media.complete && media.naturalWidth === 0) fallback();
  });
</script>
