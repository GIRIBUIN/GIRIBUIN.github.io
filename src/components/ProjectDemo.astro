---
import type { Project } from '../lib/projects';
import { getUi, type Locale } from '../lib/i18n';
import { getYouTubeEmbedUrl } from '../lib/media';
import { projectImage } from '../lib/project-images';
interface Props { project: Project; locale: Locale; }
const { project, locale } = Astro.props;
const { title, thumbnail, demo, visual, links } = project.data;
const ui = getUi(locale);
const youtube = getYouTubeEmbedUrl(links.video);
const image = demo.type === 'image' || demo.type === 'terminal' && demo.format === 'image' ? demo.url : null;
const poster = await projectImage(demo.poster || thumbnail);
const hasMedia = youtube || image || poster || visual;
---
{hasMedia && <section class="project-demo" aria-labelledby="demo-heading">
  <h2 id="demo-heading">{ui.demo}</h2>
  {youtube ? <div class="video-wrapper"><iframe src={youtube} title={title + ' — YouTube'} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
    : image || poster ? <figure class="project-image"><img src={image || poster!} alt={demo.alt || title + ' — ' + ui.openImage} width="800" height="450" loading="lazy" decoding="async" /></figure> : null}
  {visual && <details class="reference-image"><summary>{locale === 'ko' ? '기존 참고 화면' : 'Earlier reference screen'}</summary><figure><img src={visual.url} alt={visual.alt} width="1200" height="750" loading="lazy" /><figcaption>{visual.caption}</figcaption></figure></details>}
</section>}
<script>
  import { onPageLoad } from '../lib/page-lifecycle';
  onPageLoad(signal => {
    document.querySelectorAll<HTMLImageElement>('.project-demo img').forEach(media => {
      const fallback = () => {
        if (!media.isConnected) return;
        const text = document.createElement('p'); text.className = 'media-error';
        text.textContent = document.documentElement.lang === 'ko' ? '미디어를 불러오지 못했습니다. 원본 링크에서 확인해 주세요.' : 'Media could not be loaded. Use the original link.';
        media.replaceWith(text);
      };
      media.addEventListener('error', fallback, { once: true, signal });
      if (media instanceof HTMLImageElement && media.complete && !media.naturalWidth) fallback();
    });
  });
</script>
