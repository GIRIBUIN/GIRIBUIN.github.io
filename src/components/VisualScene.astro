---
import PetScene from './PetScene';
import type { Locale } from '../i18n/ui';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
---
<link rel="preload" href="/models/pet.glb" as="fetch" crossorigin="anonymous" />
<div class="visual-scene" data-pet-scene data-model-src="/models/pet.glb" data-scene-state="loading">
  <PetScene locale={locale} client:only="react" />
</div>
<style is:global>
  .visual-scene { position: absolute; left: 50%; width: min(900px, 100%); top: 84px; bottom: 132px; translate: -50% 0; }
  .visual-scene::before { content: ''; position: absolute; inset: 3% 0 0; background: radial-gradient(ellipse at 38% 31%, rgb(160 149 92 / 12%), transparent 58%), radial-gradient(ellipse at 64% 61%, rgb(80 96 65 / 7%), transparent 55%); mask-image: radial-gradient(ellipse closest-side, #000 45%, transparent 100%); pointer-events: none; }
  .visual-scene::after { content: ''; position: absolute; left: 18%; right: 18%; top: 78%; height: 15%; border-radius: 50%; background: radial-gradient(ellipse, rgb(5 7 4 / 48%), transparent 68%), radial-gradient(ellipse, rgb(148 142 82 / 7%), transparent 75%); pointer-events: none; }
  .pet-stage { position: relative; z-index: 1; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; outline: none; }
  .pet-stage[data-dragging] { cursor: grabbing; }
  .pet-stage:focus-visible { outline: 2px solid var(--accent); outline-offset: -8px; border-radius: var(--radius-md); }
  .scene-poster { position: absolute; inset: 12%; width: 76%; height: 76%; object-fit: contain; }
  @media (max-width: 700px) {
    .visual-scene { top: 68px; bottom: 188px; }
  }
</style>
