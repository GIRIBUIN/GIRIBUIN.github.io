---
import { site } from '../data/site';
import { getUi, type Locale } from '../i18n/ui';
import HeroScene from './HeroScene.astro';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const ui = getUi(locale);
---
<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="shell hero-layout">
    <div class="hero-content">
      <p class="eyebrow hero-kicker">Independent thinking. Connected systems.</p>
      <h1 id="hero-title">{site.handle}</h1>
      <p class="hero-positioning">{site.role}</p>
      <p class="hero-intro" data-i18n="profile.intro" data-stable-copy>{site.intro[locale]}</p>
      <div class="hero-links">
        <a class="button primary" href="#projects"><span data-i18n="hero.work">{ui.hero.work}</span><span aria-hidden="true">↗</span></a>
        {site.resumeUrl && <a class="button" href={site.resumeUrl} target="_blank" rel="noreferrer" data-action="resume"><span data-i18n="hero.resume">{ui.hero.resume}</span><span aria-hidden="true">↗</span></a>}
        {site.portfolioPdfUrl && <a class="button portfolio-link" href={site.portfolioPdfUrl} target="_blank" rel="noreferrer" data-action="portfolio-pdf"><span data-i18n="hero.portfolio">{ui.hero.portfolio}</span><span aria-hidden="true">↗</span></a>}
      </div>
    </div>
    <HeroScene />
    <div class="hero-baseline" aria-hidden="true"><span>PORTFOLIO / ENGINEERING & EXPLORATION</span><span>SCROLL TO EXPLORE ↓</span></div>
  </div>
</section>
