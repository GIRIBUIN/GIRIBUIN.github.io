---
import { site } from '../data/site';
import { getUi, type Locale } from '../i18n/ui';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const ui = getUi(locale);
---
<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-art" aria-hidden="true"><span></span><span></span></div>
  <div class="hero-content">
    {site.heroImage && <div class="hero-avatar"><img src={site.heroImage} alt={site.heroAlt[locale]} data-i18n-alt="profile.heroAlt" width="1254" height="1254" fetchpriority="high" /></div>}
    <h1 id="hero-title">{site.handle}</h1>
    <p class="hero-positioning" data-i18n="hero.positioning" data-stable-copy>{ui.hero.positioning}</p>
    <p class="hero-intro" data-i18n="profile.intro" data-stable-copy>{site.intro[locale]}</p>
    <ol class="hero-trace" aria-label={ui.trace.flow} data-i18n-aria-label="trace.flow">
      {(['problem', 'structure', 'system'] as const).map(step => <li>
        <span class="hero-trace-label">{step.toUpperCase()}</span>
        <span class="hero-trace-copy" data-i18n={'trace.' + step} data-stable-copy>{ui.trace[step]}</span>
      </li>)}
    </ol>
    <div class="hero-links">
      <a class="button primary" href="#projects"><span data-i18n="hero.work">{ui.hero.work}</span></a>
      {site.resumeUrl && <a class="button" href={site.resumeUrl} target="_blank" rel="noreferrer" data-action="resume"><span data-i18n="hero.resume">{ui.hero.resume}</span></a>}
      {site.portfolioPdfUrl && <a class="button" href={site.portfolioPdfUrl} target="_blank" rel="noreferrer" data-action="portfolio-pdf"><span data-i18n="hero.portfolio">{ui.hero.portfolio}</span></a>}
    </div>
  </div>
</section>
<style>
  .hero-art { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .hero-art span { position: absolute; width: clamp(180px, 20vw, 260px); aspect-ratio: 1; border-radius: 50%; }
  .hero-art span:first-child { top: 20%; left: 5%; border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent); background: radial-gradient(circle at 65% 48%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 68%); box-shadow: 0 0 0 44px color-mix(in srgb, var(--accent) 3%, transparent), 0 0 0 88px color-mix(in srgb, var(--accent) 2%, transparent); }
  .hero-art span:last-child { right: 5%; bottom: 16%; border: 1px solid color-mix(in srgb, var(--purple) 28%, transparent); background: radial-gradient(circle at 35% 45%, color-mix(in srgb, var(--coral) 9%, transparent), transparent 68%); box-shadow: 0 0 0 44px color-mix(in srgb, var(--purple) 3%, transparent), 0 0 0 88px color-mix(in srgb, var(--purple) 2%, transparent); }
  .hero-content { width: min(860px, calc(100% - 112px)); }
  .hero-links .button { border-radius: 999px; }
  .hero-trace { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: min(100%, 660px); margin: 28px 0 0; text-align: left; }
  .hero-trace li { position: relative; min-width: 0; padding: 16px 12px 0; border-top: 1px solid var(--line); }
  .hero-trace li::before { content: ''; position: absolute; top: -3px; left: 12px; width: 5px; height: 5px; border: 1px solid var(--muted); border-radius: 50%; background: var(--bg); }
  .hero-trace li:last-child::before { border-color: var(--accent-ink); background: var(--accent); }
  .hero-trace-label { display: block; color: var(--text-muted); font-size: 10px; letter-spacing: .14em; }
  .hero-trace-copy { display: block; margin-top: 5px; font-size: 13px; line-height: 1.5; color: var(--text-muted); }
  @media (max-width: 1000px) {
    .hero-content { width: calc(100% - 64px); }
  }
  @media (max-width: 700px) {
    .hero-content { width: calc(100% - 40px); }
    .hero-art { display: none; }
    .hero-trace { grid-template-columns: 1fr; width: min(calc(100% - 8px), 340px); margin-top: 24px; }
    .hero-trace li { display: grid; grid-template-columns: 90px minmax(0, 1fr); align-items: baseline; gap: 12px; border-top: 0; border-left: 1px solid var(--line); padding: 8px 0 8px 18px; }
    .hero-trace li::before { top: 14px; left: -3px; }
    .hero-trace-copy { margin: 0; font-size: 12px; }
  }
</style>
