---
import { site } from '../data/site';
import { getUi, localePath, type Locale } from '../i18n/ui';
import SocialIcon from './SocialIcon.astro';
import SettingsHud from './SettingsHud.astro';
interface Props { locale?: Locale; menuHome?: boolean; }
const { locale = 'en', menuHome = false } = Astro.props;
const ui = getUi(locale);
const homePath = localePath('/', locale);

---
<header class="header" id="top" data-hidden="false">
  <div class="shell header-inner">
    <a class="header-brand" href={homePath} data-locale-path="/" aria-label={ui.home} data-i18n-aria-label="home"><img src="/favicon.svg" alt="" width="28" height="28" />{!menuHome && <span>GIRIBUIN</span>}</a>
    {!menuHome && <div class="header-actions"><div class="social-links" aria-label={ui.socialLinks} data-i18n-aria-label="socialLinks">{site.socials.filter(link => link.url).map(link => <a href={link.url!} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}><SocialIcon name={link.id} /></a>)}</div></div>}
  </div>
</header>
<SettingsHud locale={locale} />
<script>
  const header = document.querySelector<HTMLElement>('.header');
  if (header && !document.body.classList.contains('menu-home')) {
    // Keep anchor clearance in sync with the actual one/two-row header.
    const measure = () => document.documentElement.style.setProperty('--header-height', header.offsetHeight + 'px');
    new ResizeObserver(measure).observe(header);
    measure();
    let lastY = Math.max(0, scrollY), direction = 0, travel = 0, pending = false;
    const reveal = () => { header.dataset.hidden = 'false'; lastY = Math.max(0, scrollY); travel = 0; };
    const update = () => {
      const y = Math.max(0, scrollY), delta = y - lastY, nextDirection = Math.sign(delta);
      if (y <= 24) { reveal(); travel = 0; }
      else if (delta !== 0) {
        if (nextDirection !== direction) { direction = nextDirection; travel = 0; }
        travel += Math.abs(delta);
        if (travel >= (direction > 0 ? 36 : 20)) {
          header.dataset.hidden = direction > 0 && y > header.offsetHeight ? 'true' : 'false';
          travel = 0;
        }
      }
      lastY = y; pending = false;
    };
    addEventListener('scroll', () => { if (!pending) { pending = true; requestAnimationFrame(update); } }, { passive: true });
    header.addEventListener('focusin', reveal);
    document.addEventListener('keydown', event => { if (event.key === 'Tab') reveal(); });
  }
</script>

<style>
  .header-brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--text); }
  .header-brand img { width: 28px; height: 28px; }
  .header-brand span { font-size: 12px; font-weight: 600; letter-spacing: .04em; }
</style>
