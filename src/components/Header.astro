---
import { getUi, localePath, type Locale } from '../lib/i18n';
import InterfaceIcon from './InterfaceIcon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = getUi(locale);
const path = localePath(Astro.url.pathname, 'en');
const current = path.startsWith('/projects/') || path.startsWith('/work/') ? 'projects' : path.startsWith('/about/') ? 'about' : 'home';
const pages = [{ id: 'home', path: '/', label: 'Home' }, { id: 'projects', path: '/projects/', label: 'Projects' }, { id: 'about', path: '/about/', label: 'About' }] as const;
---
<header class="site-header shell">
  <a class="brand" href={localePath('/', locale)} aria-label="GIRIBUIN — Home" title="Home" data-astro-prefetch><img src="/favicon.svg" alt="" width="32" height="32" /></a>
  <nav class="primary-nav" aria-label={ui.navigation}>{pages.map(page => <a href={localePath(page.path, locale)} aria-current={current === page.id ? 'page' : undefined} data-astro-prefetch>{page.label}</a>)}</nav>
  <div class="language-menu">
    <button id="language-toggle" class="icon-link" type="button" popovertarget="language-panel" aria-label={ui.language} title="Language" aria-expanded="false" aria-controls="language-panel" aria-haspopup="dialog"><InterfaceIcon name="language" /></button>
    <nav id="language-panel" class="language-nav language-panel" popover="auto" role="dialog" aria-labelledby="language-title">
      <h2 id="language-title">Language</h2>
      {(['ko', 'en'] as const).map(code => <a href={localePath(path, code)} lang={code} hreflang={code} data-locale={code} aria-current={code === locale ? 'true' : undefined}>{code === 'ko' ? '한국어' : 'English'}</a>)}
    </nav>
  </div>
</header>
<script>
  import { onPageLoad } from '../lib/page-lifecycle';
  onPageLoad(signal => {
    const trigger = document.querySelector<HTMLButtonElement>('#language-toggle')!;
    const panel = document.querySelector<HTMLElement>('#language-panel')!;
    const header = document.querySelector<HTMLElement>('.site-header')!;
    let lastScroll = scrollY, travel = 0, scrollFrame = 0;
    const revealHeader = () => { delete header.dataset.scrollHidden; travel = 0; };
    header.addEventListener('focusin', revealHeader, { signal });
    addEventListener('scroll', () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        scrollFrame = 0;
        const position = Math.max(0, scrollY), delta = position - lastScroll;
        travel = delta * travel < 0 ? delta : travel + delta;
        lastScroll = position;
        if (position < header.offsetHeight || header.matches(':focus-within') || panel.matches(':popover-open')) revealHeader();
        else if (travel > 16) header.dataset.scrollHidden = 'true';
        else if (travel < -8) revealHeader();
        place();
      });
    }, { passive: true, signal });
    panel.querySelectorAll<HTMLAnchorElement>('a[data-locale]').forEach(link => {
      link.search = location.search; link.hash = location.hash;
      link.addEventListener('click', () => {
        try { localStorage.setItem('portfolio.locale', link.dataset.locale!); }
        catch {
          // Even blocked storage must not bounce an explicit English Home choice.
          if (link.pathname === '/' && link.dataset.locale === 'en') {
            const target = new URL(link.href); target.searchParams.set('lang', 'en'); link.href = target.href;
          }
        }
      }, { signal });
    });
    const place = (opening = false) => {
      if (!opening && !panel.matches(':popover-open')) return;
      const anchor = trigger.getBoundingClientRect();
      const viewport = window.visualViewport;
      const left = viewport?.offsetLeft || 0, top = viewport?.offsetTop || 0;
      const width = viewport?.width || innerWidth, height = viewport?.height || innerHeight;
      const panelWidth = Math.min(220, width - 32);
      panel.style.width = panelWidth + 'px';
      panel.style.maxHeight = height - 32 + 'px';
      panel.style.left = Math.max(left + 16, Math.min(anchor.right - panelWidth, left + width - panelWidth - 16)) + 'px';
      panel.style.top = Math.max(top + 16, Math.min(anchor.bottom + 8, top + height - (panel.offsetHeight || 160) - 16)) + 'px';
      panel.dataset.positioned = 'true';
    };
    panel.addEventListener('beforetoggle', event => {
      const open = (event as ToggleEvent).newState === 'open';
      trigger.setAttribute('aria-expanded', String(open));
      if (open) { revealHeader(); place(true); } else delete panel.dataset.positioned;
    }, { signal });
    panel.addEventListener('toggle', () => {
      if (panel.matches(':popover-open')) { place(); panel.querySelector<HTMLAnchorElement>('[aria-current="true"]')?.focus({ preventScroll: true }); }
    }, { signal });
    panel.addEventListener('keydown', event => {
      if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); panel.hidePopover(); trigger.focus({ preventScroll: true }); }
    }, { signal });
    const reposition = () => place();
    addEventListener('resize', reposition, { signal });
    window.visualViewport?.addEventListener('resize', reposition, { signal });
    window.visualViewport?.addEventListener('scroll', reposition, { signal });
    return () => {
      cancelAnimationFrame(scrollFrame);
      if (panel.matches(':popover-open')) panel.hidePopover();
    };
  });
</script>
