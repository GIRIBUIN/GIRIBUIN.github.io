---
interface Props { name: string; }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
  {name === 'email' && <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></g>}
  {name === 'github' ? <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.58 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
  : name === 'linkedin' ? <path d="M5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3.4 8.5h3.2V21H3.4V8.5Zm5.2 0h3.1v1.7c.7-1.2 1.9-2 3.7-2 3.4 0 4.2 2.2 4.2 5.1V21h-3.2v-6.8c0-1.6-.3-2.9-2.1-2.9-1.9 0-2.5 1.4-2.5 3.1V21H8.6V8.5Z" />
  : name !== 'email' && <text x="12" y="18" text-anchor="middle" font-family="Georgia,serif" font-size="23" font-weight="bold">{name === 'velog' ? 'v' : name.slice(0,1).toUpperCase()}</text>}
</svg>
