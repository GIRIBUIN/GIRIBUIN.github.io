---
import { type Project } from '../lib/projects';
import { getUi, localePath, type Locale } from '../i18n/ui';
import ProjectThumbnail from './ProjectThumbnail.astro';
interface Props { project: Project; locale?: Locale; hidden?: boolean; }
const { project, locale = 'en', hidden = false } = Astro.props;
const { title, slug, oneLine, summary } = project.data;
const ui = getUi(locale);
const detailPath = '/work/' + slug + '/';
---
<article class="project-card" data-project={slug} hidden={hidden} aria-labelledby={'project-' + slug}>
  <a class="project-card-link" href={localePath(detailPath, locale)} data-locale-path={detailPath} aria-label={title + ': ' + ui.project.deepDive} data-project-title={title} data-action-copy="project.deepDive">
    <ProjectThumbnail project={project} locale={locale} />
    <h3 class="project-card-title" id={'project-' + slug}>{title}</h3>
    <p class="project-card-summary" data-i18n={'projects.' + slug + '.oneLine'} data-stable-copy>{oneLine || summary}</p>
  </a>
</article>
<style>
  .project-card { min-width: 0; }
  .project-card[hidden] { display: none; }
  .project-card-link { position: relative; top: 0; display: block; height: 100%; border-radius: 10px; touch-action: manipulation; transition: top 180ms ease; }
  .project-card-link:focus-visible { outline-offset: 5px; }
  .project-card-title { margin-top: 14px; font-size: 18px; font-weight: 600; line-height: 1.3; letter-spacing: -.02em; color: var(--text); }
  .project-card-summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3em; margin-top: 6px; color: var(--text-soft); font-size: 14px; line-height: 1.5; }
  .project-card-link:is(:focus-visible, .is-previewing) { top: -5px; }
  .project-card-link :global(.project-thumbnail) { transition: box-shadow 180ms ease; }
  .project-card-link:is(:focus-visible, .is-previewing) :global(.project-thumbnail) { box-shadow: 0 16px 28px rgba(32, 33, 36, .16); }
  @media (hover: hover) and (pointer: fine) {
    .project-card-link:hover { top: -5px; }
    .project-card-link:hover :global(.project-thumbnail) { box-shadow: 0 16px 28px rgba(32, 33, 36, .16); }
  }
  @media (prefers-reduced-motion: reduce) { .project-card-link:is(:hover, :focus-visible, .is-previewing) { top: 0; } }
</style>
