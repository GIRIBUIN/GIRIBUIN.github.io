---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
---

<Layout title={project.title} description={project.summary} section="projects">
  <article>
    <a class="back-link" href="/#projects">← 프로젝트 목록</a>
    <h1>{project.title}</h1>
    <p class="project-subtitle">{project.subtitle}</p>
    <dl class="project-facts">
      <dt>기술</dt><dd>{project.stack.join(' · ')}</dd>
      <dt>코드</dt><dd><a href={project.repository}>GitHub 저장소 ↗</a></dd>
    </dl>
    <h2>프로젝트 소개</h2>
    <p>{project.overview}</p>
    {project.sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {'items' in section && section.items && <ul class="text-list">{section.items.map((item) => <li>{item}</li>)}</ul>}
      </section>
    ))}
    <p class="project-source">프로젝트의 기능과 구현 현황은 <a href={project.repository + '#readme'}>저장소 README</a>를 바탕으로 정리했습니다.</p>
    <p class="next-project"><a href={`/projects/${next.slug}/`}>다음 프로젝트: {next.title} →</a></p>
  </article>
</Layout>
