---
import Layout from '../layouts/Layout.astro';
import { resume, preparation } from '../data/resume';
import '../styles/resume.css';
---

<Layout title="이력서" section="resume">
  <div class="resume-page">
    <h1>{resume.name}</h1>
    <p class="resume-interests">{resume.interests}</p>

    <section aria-labelledby="resume-heading">
      <div class="section-heading">
        <h2 id="resume-heading">이력서</h2>
        {resume.pdfUrl && (
          <a class="resume-download" href={resume.pdfUrl} download={`${resume.name}-이력서.pdf`}>
            PDF 다운로드 ↓
          </a>
        )}
      </div>

      {resume.sections.map((section) => (
        <section class="resume-section" aria-labelledby={`resume-${section.id}`}>
          <h3 id={`resume-${section.id}`}>{section.title}</h3>
          {section.items.map((entry) => (
            <div class="resume-entry">
              <h4>{entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}</h4>
              {entry.meta && <p class="resume-meta">{entry.meta}</p>}
              <ul class="text-list">
                {entry.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </section>

    {preparation.length > 0 && (
      <section class="preparation-section" aria-labelledby="preparation-heading">
        <div class="section-heading">
          <h2 id="preparation-heading">현재 준비 중인 것</h2>
        </div>
        <ul class="preparation-list">
          {preparation.map((entry) => (
            <li>
              <div class="preparation-heading">
                <h3>{entry.title}</h3>
                <span class="preparation-status">{entry.status}</span>
              </div>
              {entry.items.length > 0 && (
                <ul class="text-list">
                  {entry.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>
