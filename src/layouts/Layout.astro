---
import '../styles/global.css';
import '../styles/game-theme.css';
import Header from '../components/Header.astro';
import LanguageController from '../components/LanguageController.astro';
import { getUi, localePath, type Locale } from '../i18n/ui';
interface Props { title?: string; description?: string; locale?: Locale; menuHome?: boolean; standaloneDetail?: boolean; }
const { locale = 'en', menuHome = false, standaloneDetail = false } = Astro.props;
const ui = getUi(locale);
const portfolioName = 'GIRIBUIN';
const { title, description = ui.pageDescription } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content={menuHome || standaloneDetail ? '#161713' : '#0d0e10'} />
    {!import.meta.env.PROD && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={localePath(Astro.url.pathname, 'en')} />
    <link rel="alternate" hreflang="ko" href={localePath(Astro.url.pathname, 'ko')} />
    <title>{title ? `${portfolioName}/${title}` : portfolioName}</title>
  </head>
  <body class:list={{ 'menu-home': menuHome, 'detail-standalone': standaloneDetail, 'game-theme': menuHome || standaloneDetail }}><a class="skip-link" href="#main" data-i18n="skip">{ui.skip}</a>{!standaloneDetail && <Header locale={locale} menuHome={menuHome} />}
    <main id="main" tabindex="-1"><slot /></main>
    <LanguageController />
  </body>
</html>
