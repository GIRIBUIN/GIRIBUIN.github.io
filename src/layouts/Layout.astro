---
import '../styles/global.css';
import Header from '../components/Header.astro';
import LanguageController from '../components/LanguageController.astro';
import { site } from '../data/site';
import { getUi, localePath, type Locale } from '../i18n/ui';
interface Props { title?: string; description?: string; locale?: Locale; }
const { locale = 'en' } = Astro.props;
const ui = getUi(locale);
const { title = ui.pageTitle, description = ui.pageDescription } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#0d0e10" />
    {!import.meta.env.PROD && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={localePath(Astro.url.pathname, 'en')} />
    <link rel="alternate" hreflang="ko" href={localePath(Astro.url.pathname, 'ko')} />
    <title>{site.handle} · {title}</title>
  </head>
  <body><a class="skip-link" href="#main" data-i18n="skip">{ui.skip}</a><Header locale={locale} />
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="shell footer"><span>@{site.handle.toLowerCase()}</span>
      <nav class="footer-links" aria-label={ui.footer.navigation} data-i18n-aria-label="footer.navigation">
        {site.resumeUrl && <a href={site.resumeUrl} target="_blank" rel="noreferrer" data-i18n="hero.resume">{ui.hero.resume}</a>}
        {site.portfolioPdfUrl && <a href={site.portfolioPdfUrl} target="_blank" rel="noreferrer" data-i18n="hero.portfolio">{ui.hero.portfolio}</a>}
        <a href={localePath('/projects/', locale)} data-locale-path="/projects/" data-i18n="footer.projects">{ui.footer.projects}</a>
        <a href={localePath('/#hero', locale)} data-locale-path="/#hero" data-i18n="footer.home">{ui.footer.home}</a>
      </nav>
    </footer><LanguageController />
  </body>
</html>
